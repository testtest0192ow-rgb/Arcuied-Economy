# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# MongoDB Atlas connection string
MONGODB_URI=

# Максимум серверов одновременно (не список конкретных ID — просто лимит по
# количеству; бот сам выходит с сервера сверх этого числа)
MAX_GUILDS=10

# Для мгновенного обновления команд на ОДНОМ тестовом сервере во время разработки
# (глобальные команды из npm run deploy-commands расходятся по Discord до часа)
TEST_GUILD_ID=

# Bot owner Discord user ID (full access, for /eco and future admin tools)
BOT_OWNER_ID=

# Cooldown for /timely in hours (default 12)
TIMELY_COOLDOWN_HOURS=12

# Гифки результата /coinflip — отдельная для орла и отдельная для решки
COINFLIP_HEADS_GIF_URL=
COINFLIP_TAILS_GIF_URL=

# Прямая ссылка на GIF для стадии "Дуэль началась" (необязательно)
DUEL_GIF_URL=

# Прямая ссылка на GIF для результата /dice (необязательно)
DICE_GIF_URL=

# Белые кастомные emoji для сортировки в /shop, формат <:name:ID>. Не обязательно —
# по умолчанию используются символы ★ ↓ ↑ ▦, которые Discord и так рисует
# плоским белым/серым цветом, без всякой загрузки на сервер.
SORT_ICON_POPULAR=
SORT_ICON_CHEAP=
SORT_ICON_EXPENSIVE=
SORT_ICON_NEW=

# Канал (ID), куда будут приходить уведомления о новых /report
REPORT_CHANNEL_ID=
