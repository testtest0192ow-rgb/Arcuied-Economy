# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# MongoDB Atlas connection string
MONGODB_URI=

# Comma-separated list of the ~10 guild IDs this bot is allowed to run in
ALLOWED_GUILD_IDS=

# Bot owner Discord user ID (full access, for /eco and future admin tools)
BOT_OWNER_ID=

# Cooldown for /timely in hours (default 12)
TIMELY_COOLDOWN_HOURS=12
